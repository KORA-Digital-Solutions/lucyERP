// POC ERP Clínica Estética — Fase 1
// Agenda por cabinas + recordatorios WhatsApp.
//
// Nota: SQLite (vía Prisma) NO soporta `enum`. Los campos que en el spec
// son enums se modelan como `String` con un valor por defecto y se validan
// en la capa de aplicación (ver lib/enums.ts). El modelo incluye `clinicId`
// en todas las tablas para facilitar la evolución futura a multi-tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Clinic {
  id                   String   @id @default(cuid())
  name                 String
  // Lo que se lee en la pantalla del PIN, debajo del nombre. Es lo primero
  // que ve el centro al encender, así que se edita desde Configuración y no
  // está escrito a fuego en el código.
  slogan               String?
  taxId                String?
  address              String?
  phone                String?
  email                String?
  timezone             String   @default("Europe/Madrid")
  openingTime          String   @default("09:00")
  closingTime          String   @default("20:00")
  whatsappEnabled      Boolean  @default(false)
  whatsappTemplateName String?  @default("appointment_reminder_es")
  whatsappTemplateLang String?  @default("es")
  reminderHoursBefore  Int      @default(24)
  inactivityWarningDays Int     @default(180)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users        User[]
  cabins       Cabin[]
  customers    Customer[]
  services     Service[]
  serviceFamilies ServiceFamily[]
  appointments Appointment[]
  suppliers    Supplier[]
  products     Product[]
  sales        Sale[]
  cashRegisters CashRegister[]
  clinicWeeklySlots       ClinicWeeklySlot[]
  workerWeeklySlots       WorkerWeeklySlot[]
  clinicScheduleOverrides ClinicScheduleOverride[]
  workerScheduleOverrides WorkerScheduleOverride[]
  holidays                Holiday[]
  workerLeaveBalances     WorkerLeaveBalance[]
  workerLeaves            WorkerLeave[]
  customerReminders CustomerReminder[]
}

// role: "ADMIN" | "WORKER"
model User {
  id                  String   @id @default(cuid())
  clinicId            String
  clinic              Clinic   @relation(fields: [clinicId], references: [id])
  name                String
  lastName            String?
  email               String?  @unique
  passwordHash        String?
  mustChangePassword  Boolean  @default(false)
  // PIN de mostrador: identifica a quién hace la acción en un puesto
  // compartido, donde la sesión es del puesto y no de nadie. Se guarda
  // hasheado como la contraseña, pero NO es una contraseña: cuatro dígitos se
  // ven desde el otro lado del mostrador. Sirve para atribuir, no para
  // proteger, y por eso nunca abre las pantallas de administración.
  pinHash             String?
  // El PIN lo genera la administradora al dar de alta; la trabajadora elige el
  // suyo la primera vez que entra. Mismo criterio que mustChangePassword, pero
  // para el otro modo de acceso.
  mustChangePin       Boolean  @default(false)
  phone               String?
  role                String   @default("WORKER")
  active              Boolean  @default(true)
  color               String?  @default("#3C54A4")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  appointments         Appointment[]
  sales                Sale[]
  balanceMovements     CustomerBalanceMovement[]
  cashRegistersClosedBy CashRegister[]
  weeklySlots          WorkerWeeklySlot[]
  scheduleOverrides    WorkerScheduleOverride[]
  leaveBalances        WorkerLeaveBalance[]
  leaves               WorkerLeave[]
  customerReminders    CustomerReminder[] @relation("CustomerReminderCreatedBy")
  customerRemindersCompleted CustomerReminder[] @relation("CustomerReminderCompletedBy")
  saleLines            SaleLine[]
}

model Cabin {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  name        String
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
}

model Customer {
  id            String    @id @default(cuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  // Nº de expediente: consecutivo por clínica, se muestra a 4 dígitos (0001).
  // Cuadra la ficha digital con la carpeta física del archivo del centro.
  fileNumber    Int
  firstName     String
  // Nombre, primer apellido y teléfono son los tres campos obligatorios de la
  // ficha; el segundo apellido no, que no todo el mundo tiene.
  lastName      String
  lastName2     String?
  sex           String?   // "FEMALE" | "MALE" (ver lib/enums.ts)
  birthDate     DateTime?
  profession    String?
  phone         String
  // Etiqueta de quién es cada teléfono ("madre", "trabajo"…): en menores el
  // segundo teléfono suele ser el de un familiar y hay que saber a quién llamas.
  phoneLabel    String?
  phone2        String?
  phone2Label   String?
  email         String?
  address       String?
  referralSource String?  // Cómo nos ha conocido (ver lib/enums.ts)
  allergies     String?
  notes         String?
  whatsappOptIn Boolean   @default(true)
  active        Boolean   @default(true)
  balanceCents  Int       @default(0) // Saldo a favor (crédito), siempre >= 0. La deuda vive en Sale.status = DEBT.
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointments     Appointment[]
  whatsappMessages WhatsappMessage[]
  sales            Sale[]
  balanceMovements CustomerBalanceMovement[]
  reminders        CustomerReminder[]

  @@unique([clinicId, fileNumber])
}

model ServiceFamily {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]

  @@index([clinicId])
}

// pricingType: "FIXED" | "PER_MINUTE"
model Service {
  id                  String   @id @default(cuid())
  clinicId            String
  clinic              Clinic   @relation(fields: [clinicId], references: [id])
  familyId            String
  family              ServiceFamily @relation(fields: [familyId], references: [id])
  name                String
  description         String?
  durationMinutes     Int
  priceCents          Int
  pricingType         String   @default("FIXED")
  pricePerMinuteCents Int?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  appointments Appointment[]
  saleLines    SaleLine[]

  @@index([familyId])
}

// status: PENDING | CONFIRMED | CANCELLED | DONE | NO_SHOW
// reminderStatus: NOT_SCHEDULED | PENDING | SENDING | SENT | FAILED | DELIVERED | READ
model Appointment {
  id                String    @id @default(cuid())
  clinicId          String
  clinic            Clinic    @relation(fields: [clinicId], references: [id])
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  serviceId         String
  service           Service   @relation(fields: [serviceId], references: [id])
  workerId          String
  worker            User      @relation(fields: [workerId], references: [id])
  cabinId           String
  cabin             Cabin     @relation(fields: [cabinId], references: [id])
  startAt           DateTime
  endAt             DateTime
  durationMinutes   Int
  status            String    @default("PENDING")
  reminderStatus    String    @default("NOT_SCHEDULED")
  notes             String?
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelReason      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  whatsappMessages WhatsappMessage[]
  saleLines        SaleLine[]

  @@index([clinicId, startAt])
  @@index([clinicId, cabinId, startAt])
  @@index([clinicId, workerId, startAt])
}

model Supplier {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

// type: SALE | INTERNAL | BOTH (legacy, now unused — kept for future)
model Product {
  id          String    @id @default(cuid())
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  name        String
  description String?
  priceCents  Int       @default(0)
  costCents   Int       @default(0)
  stock       Int       @default(0)
  stockMin    Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  movements StockMovement[]
  saleLines SaleLine[]
}

// type: ENTRY | CONSUME | SALE | ADJUST
// quantity va con signo solo en ADJUST (regularización de recuento); en los
// demás el signo lo pone el tipo y siempre es positiva.
model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  type      String
  quantity  Int
  notes     String?
  saleId    String?
  createdAt DateTime @default(now())

  @@index([productId])
}

// saleType: "SALE" | "GIFT_CARD"
// status: "PAID" | "DEBT"
// paymentMethod: "CARD" | "CASH" | "BALANCE" | "DEBT"
model Sale {
  id            String   @id @default(cuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  saleType      String   @default("SALE")
  status        String   @default("PAID")
  paymentMethod String   @default("CASH")
  subtotalCents Int      @default(0)
  discountCents Int      @default(0)
  totalCents    Int      @default(0)
  paidCents     Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines            SaleLine[]
  balanceMovements CustomerBalanceMovement[]

  @@index([clinicId, createdAt])
  @@index([clinicId, customerId])
}

// type: "SERVICE" | "PRODUCT"
model SaleLine {
  id              String   @id @default(cuid())
  saleId          String
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  type            String
  serviceId       String?
  service         Service?  @relation(fields: [serviceId], references: [id])
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id])
  description     String
  quantity        Int      @default(1)
  unitPriceCents  Int
  discountPercent Int      @default(0)
  durationMinutes Int?
  totalCents      Int
  // Quien realiza el servicio o vende la tarjeta regalo. Es distinto de
  // Sale.userId, que es quien cobra: en el mostrador cobra una y atiende otra.
  workerId        String?
  worker          User?    @relation(fields: [workerId], references: [id])
  // Solo lo usan las tarjetas regalo, para apuntar qué se le regala. La tarjeta
  // es saldo suelto, no va atada a un servicio, así que lo que se plantea
  // regalar no cabe en ningún otro campo.
  notes           String?
  // La cita que se está cobrando, cuando la línea sale de la agenda. Es único
  // para que la base impida cobrar dos veces la misma cita: en SQLite varios
  // NULL conviven sin chocar, así que las líneas sueltas no se estorban.
  appointmentId   String?      @unique
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([saleId])
}

// type: "GIFT_CARD_IN" | "BALANCE_USED"  (DEBT_CREATED/DEBT_PAID: legacy, ya no se generan)
model CustomerBalanceMovement {
  id          String   @id @default(cuid())
  clinicId    String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String
  amountCents Int
  saleId      String?
  sale        Sale?    @relation(fields: [saleId], references: [id])
  notes       String?
  createdAt   DateTime @default(now())

  @@index([customerId])
}

// status: "OPEN" | "CLOSED"
model CashRegister {
  id                  String    @id @default(cuid())
  clinicId            String
  clinic              Clinic    @relation(fields: [clinicId], references: [id])
  date                String
  status              String    @default("OPEN")
  openingCashCents    Int       @default(0)
  totalCardCents      Int       @default(0)
  totalCashCents      Int       @default(0)
  closingDeclaredCents Int?
  closingKeptCents    Int?
  differenceCents     Int?
  denominationNotes   String?
  closedByUserId      String?
  closedBy            User?     @relation(fields: [closedByUserId], references: [id])
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([clinicId, date])
  @@index([clinicId, date])
}

// direction: OUTBOUND | INBOUND
// status: PENDING | SENT | FAILED | DELIVERED | READ | RECEIVED
model WhatsappMessage {
  id                String       @id @default(cuid())
  clinicId          String
  appointmentId     String?
  appointment       Appointment? @relation(fields: [appointmentId], references: [id])
  customerId        String?
  customer          Customer?    @relation(fields: [customerId], references: [id])
  direction         String
  toPhone           String?
  fromPhone         String?
  templateName      String?
  templateLanguage  String?
  providerMessageId String?
  status            String       @default("PENDING")
  payloadJson       String?
  responseJson      String?
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  receivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([clinicId, appointmentId])
  @@index([providerMessageId])
}

// ---------------------------------------------------------------------------
// Horarios (centro + empleadas) y vacaciones/asuntos propios
// ---------------------------------------------------------------------------

// Horario semanal por defecto del centro. Varias filas por dayOfWeek permiten
// horario partido (mañana + tarde). dayOfWeek: 0=domingo .. 6=sábado.
model ClinicWeeklySlot {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, dayOfWeek])
}

// Horario semanal por defecto de una empleada. Varias filas por dayOfWeek
// permiten turno partido.
model WorkerWeeklySlot {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  workerId  String
  worker    User     @relation(fields: [workerId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId, dayOfWeek])
}

// Excepción puntual del horario del CENTRO para una fecha concreta. Si existe
// fila para (clinicId, date), sustituye por completo al horario semanal base
// de ese día (closed=true o sin slots = cerrado todo el día). Tiene prioridad
// sobre Holiday: un festivo con excepción explícita del admin usa esta.
model ClinicScheduleOverride {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  date      String
  closed    Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots ClinicScheduleOverrideSlot[]

  @@unique([clinicId, date])
}

model ClinicScheduleOverrideSlot {
  id         String                 @id @default(cuid())
  overrideId String
  override   ClinicScheduleOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)
  startTime  String
  endTime    String

  @@index([overrideId])
}

// Excepción puntual del horario de una EMPLEADA para una fecha concreta.
// Misma semántica que ClinicScheduleOverride pero a nivel individual.
model WorkerScheduleOverride {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  workerId  String
  worker    User     @relation(fields: [workerId], references: [id])
  date      String
  closed    Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots WorkerScheduleOverrideSlot[]

  @@unique([clinicId, workerId, date])
}

model WorkerScheduleOverrideSlot {
  id         String                 @id @default(cuid())
  overrideId String
  override   WorkerScheduleOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)
  startTime  String
  endTime    String

  @@index([overrideId])
}

// Festivo del calendario laboral. Afecta solo al horario del CENTRO (cerrado
// por defecto), salvo que exista un ClinicScheduleOverride explícito para esa
// fecha, en cuyo caso este último manda y las empleadas recuperan su horario
// semanal base normal ese día (la resolución de horario de empleada nunca
// consulta Holiday directamente).
// scope: "NATIONAL" | "REGIONAL" | "LOCAL" (informativo)
model Holiday {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  date      String
  name      String
  scope     String   @default("LOCAL")
  createdAt DateTime @default(now())

  @@unique([clinicId, date])
}

// Saldo anual de días de vacaciones y asuntos propios de una empleada.
model WorkerLeaveBalance {
  id                String   @id @default(cuid())
  clinicId          String
  clinic            Clinic   @relation(fields: [clinicId], references: [id])
  workerId          String
  worker            User     @relation(fields: [workerId], references: [id])
  year              Int
  vacationDaysTotal Float    @default(0)
  personalDaysTotal Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([clinicId, workerId, year])
}

// Día libre concreto asignado a una empleada (día completo). El saldo
// restante se calcula al vuelo: total (WorkerLeaveBalance) - nº de filas del
// año correspondiente, sin contador redundante. Bloquea la agenda ese día
// igual que una excepción de horario "closed".
// type: "VACATION" | "PERSONAL"
model WorkerLeave {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  workerId        String
  worker          User     @relation(fields: [workerId], references: [id])
  date            String
  type            String
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@unique([clinicId, workerId, date])
  @@index([workerId, date])
}
// Notas/recordatorios de las empleadas sobre un cliente
// (ej. "se hizo un láser, cita de seguimiento en 6 meses").
model CustomerReminder {
  id              String    @id @default(cuid())
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id])
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  createdByUserId String
  createdByUser   User      @relation("CustomerReminderCreatedBy", fields: [createdByUserId], references: [id])
  title           String
  // Sin fecha = recordatorio permanente: un aviso de la ficha que sale siempre
  // que se atiende a ese cliente ("alérgica al látex") y no vence solo. Con
  // fecha es una tarea que vence, y entonces alertDaysBefore dice desde cuándo
  // avisa el dashboard.
  dueDate         DateTime?
  alertDaysBefore Int       @default(7)
  completedAt     DateTime?
  completedByUserId String?
  completedByUser   User?   @relation("CustomerReminderCompletedBy", fields: [completedByUserId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clinicId, completedAt, dueDate])
  @@index([customerId])
}
